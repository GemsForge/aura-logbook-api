{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "SeedUsersOnStartup": false
  },
  "Jwt": {
    "Issuer": "AuraLogbook",
    "Audience": "AuraLogbookUsers",
    "ExpiresInMinutes": 60
  },
  "Spotify": {
    "ApiBaseUrl": "https://api.spotify.com/v1"
  },
  "AllowedHosts": "*"
}
