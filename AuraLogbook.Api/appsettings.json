{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "UserFilePath": "Data/users.json",
    "MoodFilePath": "Data/moods.json",
    "ZodiacFilePath": "Data/zodiacInsights.json",
    "PrivateMediaPath": "Data/private-media"
  },
  "Database": {
    "ConnectionString": "Data Source=Data/auralogbook.db",
    "SeedUsersOnStartup": false
  },
  "Jwt": {
    "Issuer": "AuraLogbook",
    "Audience": "AuraLogbookUsers",
    "ExpiresInMinutes": 60
  },
  "Spotify": {
    "RedirectUri": "http://127.0.0.1:5082/api/spotify/callback",
    "FrontendRedirectUri": "http://127.0.0.1:58407/dashboard",
    "ApiBaseUrl": "https://api.spotify.com/v1"
  },
  "AllowedHosts": "*"
}
